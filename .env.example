# Application
APP_NAME=Test Platform
APP_VERSION=1.0.0
DEBUG=true

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/test_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# JWT (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=please-change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# API
API_V1_PREFIX=/api/v1

# Test execution (F014 有限并发)
# Default max cases running in parallel inside a single TestRun.
# Set to 1 to restore serial execution. Capped at 64 by the API layer.
TEST_RUN_MAX_CONCURRENCY=4
